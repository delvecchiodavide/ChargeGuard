<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchDaemon definition consumed by SMAppService.daemon(plistName:).
     Must be copied to ChargeGuard.app/Contents/Library/LaunchDaemons/. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.chargeguard.helper</string>
    <!-- Path relative to the app bundle root (SMAppService resolves it). -->
    <key>BundleProgram</key>
    <string>Contents/MacOS/ChargeGuardHelper</string>
    <key>MachServices</key>
    <dict>
        <key>com.example.chargeguard.helper</key>
        <true/>
    </dict>
    <!-- Shows the daemon under the app's name in Login Items & Extensions. -->
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.example.chargeguard</string>
    </array>
    <!-- Start at boot so the safety watchdog runs even before the app launches. -->
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
